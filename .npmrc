; Resolve peer dependencies the way npm does by default.
;
; This is here because the lockfile was once written on a machine with
; legacy-peer-deps=true set globally, which leaves them out. What got committed
; described a tree that existed on exactly one computer: `npm ci` refused on
; every platform, and anyone who cloned and ran `npm install` got a different
; install from the one the lockfile claimed.
;
; Pinning it in the repository means the answer no longer depends on whose
; machine happened to run `npm install`.
legacy-peer-deps=false
