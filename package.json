{
  "name": "session-deck",
  "version": "0.1.0",
  "description": "One panel to watch and drive every Claude Code session you have running, grouped by project",
  "keywords": [
    "claude-code",
    "claude",
    "sessions",
    "dashboard",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yainierc/session-deck.git"
  },
  "homepage": "https://github.com/yainierc/session-deck#readme",
  "bugs": {
    "url": "https://github.com/yainierc/session-deck/issues"
  },
  "type": "module",
  "bin": {
    "session-deck": "src/cli.js"
  },
  "files": [
    "src",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"node src/cli.js --no-open --port 4317\" \"vite\"",
    "build": "vite build",
    "start": "node src/cli.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "vite": "^6.0.7"
  }
}
